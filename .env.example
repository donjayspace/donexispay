# =============================================================================
# DonexisPay environment template
# Copy to .env.local for development. Never commit real values.
# Production secrets belong in the hosting platform's encrypted environment.
# =============================================================================

# Core application
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/donexispay?schema=public
# Generate independently for every environment: openssl rand -base64 48
APP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
LOG_LEVEL=info

# Safety gate: keep false until provider approval, compliance review, and live-readiness checks pass.
PAYMENTS_LIVE_ENABLED=false

# Customer OAuth only. These do not grant access to /admin.
# Google redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payment provider (populate only after provider selection and approval)
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_MERCHANT_ID=

# First administrator bootstrap (temporary use only).
# Set strong values privately, run the admin bootstrap script, then remove these values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Optional error monitoring
SENTRY_DSN=

# Optional queue/cache. Without a queue provider, do not assume jobs are durable.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional outbound email provider
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional Cloudflare R2 / S3-compatible object storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
