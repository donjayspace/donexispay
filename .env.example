# App
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL: use a dedicated local development database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/donexispay?schema=public

# Generate a long random value for each environment. Do not reuse production secrets.
# Example generation: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Provider integration remains disabled until a provider has been selected and reviewed.
PAYMENTS_LIVE_ENABLED=false
